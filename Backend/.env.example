# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET=your_jwt_secret

# App
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://your-frontend-domain.example

# SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=password
SMTP_SECURE=false
FROM_EMAIL=no-reply@example.com

# Other
# NOTE: add these variables in your deployment platform dashboard.
